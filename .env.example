# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Find these in the Supabase dashboard → Project Settings → API Keys.

# Safe for the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_ and never use it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional, for pushing migrations from your machine (supabase db push --db-url).
# Dashboard → Connect → Session pooler. CI uses GitHub secrets instead.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
